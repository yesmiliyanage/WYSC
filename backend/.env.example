# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# Service role key bypasses Row Level Security — recommended for server-side use.
# Find it in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon/public key — used as fallback if SERVICE_ROLE_KEY is not set.
SUPABASE_ANON_KEY=your-anon-key

# ── AI ─────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ── Maps (optional) ────────────────────────────────────────────────────────────
# If absent, the LLM generates generic (non-location-specific) options.
GOOGLE_PLACES_API_KEY=your-google-places-key

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
# Set to "true" only in local development — never in production.
FLASK_DEBUG=false

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use "*" for local dev only; set explicit URL(s) in production.
# Example: CORS_ORIGINS=https://yourapp.com,https://staging.yourapp.com
CORS_ORIGINS=*
